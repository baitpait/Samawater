# Sama Water — قالب .env للإنتاج (sama.baitpait.space)
# انسخ هذا الملف إلى .env على السيرفر وعدّل القيم (لا ترفع .env مع المشروع)

APP_NAME="Sama Water"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://sama.baitpait.space
APP_TIMEZONE=UTC

# مفتاح التطبيق — سيُنشأ بـ: php artisan key:generate
APP_KEY=

# قاعدة البيانات — استخدم بيانات لوحة التحكم (Webuzo/cPanel)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sarfesak_sama
DB_USERNAME=sarfesak_sama
DB_PASSWORD=ضع_كلمة_مرور_قاعدة_البيانات_هنا

# الجلسات والتخزين المؤقت (يمكن ترك الافتراضي)
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# البريد (اختياري — للإنتاج يمكن استخدام log)
LOG_CHANNEL=stack
LOG_LEVEL=warning
